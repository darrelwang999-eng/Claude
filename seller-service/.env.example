# Your wallet address to receive payments
PAY_TO_ADDRESS=0xYourWalletAddress

# ERC-20 token contract address (e.g. USDG on X Layer)
ASSET_ADDRESS=0x4ae46a509f6b1d9056937ba4500cb143933d2dc8

# Payment amount in minimal units (1000000 = 1 token with 6 decimals)
PAYMENT_AMOUNT=1000000

# CAIP-2 chain identifier
NETWORK=eip155:196

# How long (seconds) a payment authorization stays valid
MAX_TIMEOUT_SECONDS=300

# EIP-712 domain of the token contract (query the contract to confirm)
TOKEN_DOMAIN_NAME=USD Coin
TOKEN_DOMAIN_VERSION=2

# HTTP port to listen on
PORT=3000
