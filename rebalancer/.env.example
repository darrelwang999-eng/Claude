# ── Execution ─────────────────────────────────────────────────────────────────
# Set DRY_RUN=false to actually execute on-chain transactions
DRY_RUN=true

# Your wallet private key (only needed when DRY_RUN=false)
PRIVATE_KEY=0xYourPrivateKey

# Pool you are currently in (e.g. aave_eth, compound_base, morpho_eth, susde)
# Leave blank to auto-detect on first run
CURRENT_POOL=

# ── RPC endpoints ─────────────────────────────────────────────────────────────
RPC_ETHEREUM=https://eth.llamarpc.com
RPC_BASE=https://mainnet.base.org

# ── Strategy parameters ───────────────────────────────────────────────────────
# Rebalance only when yield gap exceeds this (0.005 = 0.5%)
REBALANCE_THRESHOLD=0.005

# Exit sUSDe if APY drops below this
SUSDE_MIN_APY=0.03

# How many consecutive hours sUSDe must stay below SUSDE_MIN_APY before exit
EXIT_WINDOW_H=48

# Max allocation ratio to sUSDe (0.3 = 30%)
SUSDE_MAX_ALLOC=0.30

# Poll interval in milliseconds (3600000 = 1 hour)
POLL_MS=3600000
